# One container for the free Render deploy (see render.yaml).
# The exported website is served by FastAPI itself, so the browser only ever talks
# to one origin: no CORS setup and no URL wiring between two services.
# Local development still uses docker-compose.yml with separate api + web containers.

FROM node:22-alpine AS web
WORKDIR /web
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ .
ENV NEXT_PUBLIC_API_URL=/api
RUN npx next build

FROM python:3.13-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY backend/ .
COPY --from=web /web/out /app/site
RUN mkdir -p /app/media && useradd -m app && chown -R app /app
USER app
ENV CV_STATIC_DIR=/app/site
EXPOSE 8000
# Render's proxy terminates TLS - trust its forwarded headers so rate limits see real client IPs
CMD ["sh", "-c", "alembic upgrade head && python -m app.seed && uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000} --proxy-headers --forwarded-allow-ips='*' --workers ${WEB_CONCURRENCY:-1}"]
