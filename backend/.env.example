CV_ENV=dev
CV_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cineverse
CV_REDIS_URL=redis://localhost:6379/0
CV_JWT_SECRET=please-generate-a-long-random-string
CV_TICKET_SIGNING_SECRET=another-long-random-string
CV_CORS_ORIGINS=http://localhost:3000,capacitor://localhost,http://localhost
CV_HOLD_SECONDS=300
CV_PAYMENT_WINDOW_SECONDS=480

# Payments: "mock" (local sandbox simulator) or "razorpay" (Razorpay TEST mode keys)
CV_PAYMENT_PROVIDER=mock
CV_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
CV_RAZORPAY_KEY_SECRET=
CV_RAZORPAY_WEBHOOK_SECRET=

# Uploaded posters / artwork
CV_MEDIA_DIR=media
CV_MAX_UPLOAD_MB=6

# Optional: import any real movie from TMDB (free key: https://www.themoviedb.org/settings/api)
# Fill ONE of these. Leave both empty to add movies manually.
CV_TMDB_API_KEY=
CV_TMDB_READ_TOKEN=
CV_TMDB_REGION=IN
CV_TMDB_SHOW_POSTERS=true
